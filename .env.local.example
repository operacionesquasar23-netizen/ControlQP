# Copia este archivo a .env.local y reemplaza con la URL real de tu
# Apps Script Web App (la que obtienes al hacer "Implementar > Nueva
# implementación > Aplicación web" en el editor de Apps Script).
#
# En Vercel, configura esta misma variable en:
# Project Settings > Environment Variables

NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_ID_DE_DESPLIEGUE/exec
